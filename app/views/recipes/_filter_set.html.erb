<%= simple_form_for(filter_set, url: root_path, method: :get) do |filter| %>
  <%= filter.input :name %>

  <details class="filter-group mt-3" open>
    <summary id="filter_ingredients_summary" class="cursor-pointer select-none text-sm font-semibold text-ink-light mb-2">Ingredients</summary>
    <%= filter.input :ingredients, required: false, label: false, input_html: {
      class: 'autocomplete_multiple',
      'data-target' => autocompletes_ingredient_names_path,
      'aria-labelledby' => 'filter_ingredients_summary'
    } %>
  </details>

  <details class="filter-group mt-3" open>
    <summary id="filter_cooking_methods_summary" class="cursor-pointer select-none text-sm font-semibold text-ink-light mb-2">Cooking methods</summary>
    <%= filter.input :cooking_methods, label: false, input_html: {
      class: 'autocomplete_multiple',
      'data-target' => autocompletes_cooking_methods_path,
      'aria-labelledby' => 'filter_cooking_methods_summary'
    } %>
  </details>

  <details class="filter-group mt-3" open>
    <summary id="filter_cultural_influences_summary" class="cursor-pointer select-none text-sm font-semibold text-ink-light mb-2">Cultural influences</summary>
    <%= filter.input :cultural_influences, label: false, input_html: {
      class: 'autocomplete_multiple',
      'data-target' => autocompletes_cultural_influences_path,
      'aria-labelledby' => 'filter_cultural_influences_summary'
    } %>
  </details>

  <details class="filter-group mt-3" open>
    <summary id="filter_courses_summary" class="cursor-pointer select-none text-sm font-semibold text-ink-light mb-2">Courses</summary>
    <%= filter.input :courses, label: false, input_html: {
      class: 'autocomplete_multiple',
      'data-target' => autocompletes_courses_path,
      'aria-labelledby' => 'filter_courses_summary'
    } %>
  </details>

  <details class="filter-group mt-3" open>
    <summary id="filter_dietary_restrictions_summary" class="cursor-pointer select-none text-sm font-semibold text-ink-light mb-2">Dietary restrictions</summary>
    <%= filter.input :dietary_restrictions, label: false, input_html: {
      class: 'autocomplete_multiple',
      'data-target' => autocompletes_dietary_restrictions_path,
      'aria-labelledby' => 'filter_dietary_restrictions_summary'
    } %>
  </details>

  <%= filter.input :author %>

  <div class="flex items-center gap-3 mt-4">
    <%= filter.button :submit, class: 'bg-terra text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-terra-dark transition-colors cursor-pointer border-0' %>
    <%= link_to('Clear filters', root_path, class: 'text-sm text-ink-muted hover:text-terra no-underline hover:underline') %>
  </div>
<% end %>