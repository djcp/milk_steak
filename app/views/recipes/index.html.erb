<div class="grid grid-cols-1 md:grid-cols-[1fr_30%] gap-6 p-4 md:p-6">
  <div class="recipe-container min-w-0">
    <%= render 'filter_indicator', filter_set: @filter_set %>
    <% if @recipes.empty? %>
      <div class="py-12 px-4 text-center">
        <h2 class="text-2xl text-ink mb-3">
          <%= @filter_set.active_filters.present? ? 'No recipes match your search' : 'No recipes yet' %>
        </h2>
        <p class="text-ink-light text-base max-w-md mx-auto mb-6">
          <% if @filter_set.active_filters.present? %>
            Try removing a filter or searching for something else.
          <% elsif current_user.present? %>
            Be the first to add a recipe to the cookbook.
          <% else %>
            Log in to add the first recipe to the cookbook.
          <% end %>
        </p>
        <% if @filter_set.active_filters.present? %>
          <%= link_to 'Clear all filters', root_path, class: 'btn btn-outline' %>
        <% elsif current_user.present? %>
          <%= link_to 'Add your first recipe', new_recipe_path, class: 'btn btn-primary' %>
        <% else %>
          <%= link_to 'Log in', new_user_session_path, class: 'btn btn-primary' %>
        <% end %>
      </div>
    <% else %>
      <%= render 'pagination', collection: @recipes, per_page_options: [12, 24, 48] %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <%= render @recipes %>
      </div>
      <%= render 'pagination', collection: @recipes, per_page_options: [12, 24, 48] %>
    <% end %>
  </div>

  <aside class="bg-cream-dark/80 rounded-xl p-5 h-fit md:sticky md:top-4 border border-cream-dark">
    <h2 class="text-lg mb-3 text-ink-light">Search</h2>
    <%= render 'filter_set', filter_set: @filter_set %>
  </aside>
</div>

<% content_for(:page_title, home_page_title(@filter_set)) %>
