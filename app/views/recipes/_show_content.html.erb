<article class="<%= dom_class(recipe) %> max-w-5xl mx-auto p-4 md:p-6" id="<%= dom_id(recipe) %>">
  <%= render 'control_panel', recipe: recipe %>

  <div class="recipe-heading mt-6 lg:mt-8 text-center lg:text-left">
    <h1 class="text-3xl md:text-5xl text-ink"><%= recipe.name %></h1>

    <% if recipe.description? %>
      <blockquote class="description mx-auto lg:mx-0 max-w-2xl mt-4 text-ink-light italic leading-relaxed">
        <%= sanitize(markdown_format(recipe.description)) %>
      </blockquote>
    <% end %>

    <div class="recipe-metadata flex flex-wrap items-center justify-center lg:justify-start gap-2 mt-5 text-sm">
      <% if recipe.preparation_time? %>
        <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3 py-1 shadow-sm border border-cream-dark font-medium text-ink">
          <%= recipe.preparation_time %> min prep
        </span>
      <% end %>
      <% if recipe.cooking_time? %>
        <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3 py-1 shadow-sm border border-cream-dark font-medium text-ink">
          <%= recipe.cooking_time %> min total
        </span>
      <% end %>
      <% if recipe.servings? || recipe.serving_units? %>
        <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3 py-1 shadow-sm border border-cream-dark font-medium text-ink">
          Makes <%= recipe.servings %> <%= recipe.serving_units %>
        </span>
      <% end %>
      <% if recipe.user_username.present? %>
        <div class="user">
          <span class="inline-block bg-white rounded-full px-3 py-1 shadow-sm border border-cream-dark">
            by: <%= link_to recipe.user_username, root_path(filter_set: { author: recipe.user_username }), class: 'font-medium text-terra no-underline hover:underline' %>
          </span>
        </div>
      <% elsif recipe.user_email.present? %>
        <div class="user">
          <span class="inline-block bg-white rounded-full px-3 py-1 shadow-sm border border-cream-dark">
            by: <%= armored_email(recipe.user_email) %>
          </span>
        </div>
      <% end %>
      <% if recipe.created_at.present? %>
        <span class="text-ink-muted"><%= l(recipe.created_at, format: :default) %></span>
      <% end %>
    </div>
  </div>

  <% if recipe.featured_image? %>
    <div class="hero-image mt-6 lg:mt-8">
      <%= image_tag(recipe.featured_image.image_url(:large),
        alt: recipe.featured_image.caption.presence || recipe.name,
        class: 'w-full aspect-[16/9] object-cover rounded-2xl shadow-sm') %>
    </div>
  <% end %>

  <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
    <div class="recipe_ingredients bg-white rounded-xl px-6 py-5 shadow-sm">
      <h2 class="font-display text-xl text-ink mb-4">Ingredients</h2>
      <% recipe.recipe_ingredients.group_by(&:section).each do |section, ingredients| %>
        <% if section.present? %>
          <h3 class="font-semibold text-ink mt-4 mb-1 first:mt-0"><%= section %></h3>
        <% end %>
        <ul class="list-none">
          <%= render ingredients %>
        </ul>
      <% end %>
    </div>

    <div class="directions">
      <h2 class="font-display text-xl text-ink mb-4">Directions</h2>
      <div class="markdown-content text-ink-light leading-relaxed">
        <%= sanitize(markdown_format(recipe.directions)) if recipe.directions? %>
      </div>
    </div>
  </div>

  <div class="mt-10 pt-6 border-t border-cream-dark">
    <div class="flex flex-wrap gap-x-8 gap-y-4">
      <%= render 'recipes/tagged_attributes', recipe: recipe, attribute: 'cooking_methods' %>
      <%= render 'recipes/tagged_attributes', recipe: recipe, attribute: 'cultural_influences' %>
      <%= render 'recipes/tagged_attributes', recipe: recipe, attribute: 'courses' %>
      <%= render 'recipes/tagged_attributes', recipe: recipe, attribute: 'dietary_restrictions' %>
    </div>
  </div>

  <% if recipe.images.any? %>
    <div class="images mt-10" id="image_list">
      <h2 class="font-display text-xl text-ink mb-4">Photos</h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-4">
        <%= render recipe.images %>
      </div>
    </div>
  <% end %>
</article>