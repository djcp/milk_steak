<div class="max-w-md mx-auto p-6">
  <h2 class="text-2xl text-ink mb-6">Change your password</h2>

  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.error_notification %>
    <%= f.full_error :reset_password_token %>

    <div class="space-y-4">
      <%= f.input :reset_password_token, as: :hidden %>
      <%= f.input :password,
            label: 'New password',
            required: true,
            autofocus: true,
            hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
            input_html: { autocomplete: 'new-password' } %>
      <%= f.input :password_confirmation,
            label: 'Confirm your new password',
            required: true,
            input_html: { autocomplete: 'new-password' } %>
    </div>

    <div class="mt-6">
      <%= f.button :submit, 'Change my password', class: 'bg-terra-dark text-white px-5 py-2 rounded-lg hover:bg-terra font-medium transition-colors' %>
    </div>
  <% end %>

  <div class="mt-6 text-sm text-ink-light space-y-2">
    <%= render 'devise/shared/links' %>
  </div>
</div>
<% content_for(:page_title, 'Change your password') %>