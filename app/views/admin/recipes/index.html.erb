<div class="max-w-6xl mx-auto">
  <h1 class="text-3xl text-ink mb-6">Admin: Recipes</h1>

  <div class="bg-white rounded-xl shadow-sm border border-cream-dark overflow-hidden">
    <div class="flex items-center gap-x-2 overflow-x-auto border-b border-cream-dark bg-gray-50 px-4 py-2.5 text-sm">
      <% all_active = params[:status].blank? %>
      <%= link_to "All (#{@status_counts.values.sum})", admin_recipes_path,
          class: ['whitespace-nowrap no-underline px-3 py-1.5 rounded-full text-xs font-medium transition-colors',
                  all_active ? 'bg-terra text-white' : 'text-ink-light hover:text-terra hover:bg-terra-faint'].join(' ') %>
      <% Recipe::STATUSES.each do |s| %>
        <% active = params[:status] == s %>
        <% count = @status_counts[s] || 0 %>
        <%= link_to "#{s.titleize} (#{count})", admin_recipes_path(status: s),
            class: ['whitespace-nowrap no-underline px-3 py-1.5 rounded-full text-xs font-medium transition-colors',
                    active ? 'bg-terra text-white' : 'text-ink-light hover:text-terra hover:bg-terra-faint',
                    count.zero? && !active ? 'opacity-50' : nil].compact.join(' ') %>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left">
          <tr>
            <th class="px-4 py-3 font-semibold text-ink">Name</th>
            <th class="px-4 py-3 font-semibold text-ink">Author</th>
            <th class="px-4 py-3 font-semibold text-ink">Status</th>
            <th class="px-4 py-3 font-semibold text-ink">Runs</th>
            <th class="px-4 py-3 font-semibold text-ink">Created</th>
            <th class="px-4 py-3 font-semibold text-ink">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @recipes.each do |recipe| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3">
                <%= link_to recipe.name, recipe_path(recipe), class: 'text-terra hover:underline no-underline font-medium' %>
                <% if recipe.magic? %>
                  <span class="text-xs text-purple-600">(magic)</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-ink-light"><%= recipe.user_username %></td>
              <td class="px-4 py-3"><%= render 'status_badge', status: recipe.status %></td>
              <td class="px-4 py-3 text-ink-light">
                <%= link_to @run_counts[recipe.id] || 0,
                    admin_ai_classifier_runs_path(recipe_id: recipe.id),
                    class: 'text-terra hover:underline' %>
              </td>
              <td class="px-4 py-3 text-ink-light"><%= l(recipe.created_at, format: :default) %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <% if recipe.publishable? %>
                    <%= button_to 'Publish', publish_admin_recipe_path(recipe), method: :patch, class: 'btn btn-success' %>
                    <%= button_to 'Reject', reject_admin_recipe_path(recipe), method: :patch, class: 'btn btn-outline-danger' %>
                  <% end %>
                  <% if recipe.reprocessable? %>
                    <%= button_to 'Reprocess', reprocess_admin_recipe_path(recipe), method: :patch, class: 'btn btn-warn' %>
                  <% end %>
                  <%= link_to 'Edit', edit_recipe_path(recipe), class: 'btn btn-outline' %>
                  <span class="w-px h-5 bg-cream-dark mx-1"></span>
                  <%= button_to 'Delete', admin_recipe_path(recipe), method: :delete,
                      class: 'btn btn-danger', data: { confirm: 'Are you sure?' } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4">
    <%= will_paginate @recipes %>
  </div>
</div>
<% content_for(:page_title, 'Admin: Recipes') %>