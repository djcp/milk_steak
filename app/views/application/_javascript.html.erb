<%= javascript_include_tag "jquery", defer: true %>
<%= javascript_include_tag "jquery-ui", defer: true %>
<%= javascript_include_tag "rails-ujs", defer: true %>
<%= javascript_include_tag "recipes/show", defer: true %>
<%= javascript_include_tag "recipes/new", defer: true %>
<%= javascript_include_tag "recipes_index", defer: true %>

<%= yield :javascript %>

<% if Rails.env.test? %>
  <%# defer: true is required, not cosmetic. jQuery above is deferred, so a
      classic script here would run at parse time — before jQuery exists — and
      die on `$ is not defined`, silently leaving animations on and AJAX async. %>
  <%= javascript_include_tag "test_setup", defer: true %>
<% end %>
